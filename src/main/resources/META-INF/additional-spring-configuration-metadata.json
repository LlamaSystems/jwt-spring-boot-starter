{
  "groups": [
    {
      "name": "app.security.jwt",
      "type": "io.github.aliabbosashurov.jwt.JwtProperties",
      "description": "Configuration properties for JSON Web Token.",
      "sourceType": "io.github.aliabbosashurov.jwt.JwtProperties"
    }
  ],
  "properties": [
    {
      "name": "app.security.jwt.audience",
      "type": "java.lang.String",
      "description": "Audience claim for the JWT.",
      "sourceType": "io.github.aliabbosashurov.jwt.JwtProperties",
      "defaultValue": "all"
    },
    {
      "name": "app.security.jwt.expiration",
      "type": "java.time.Duration",
      "description": "Duration after which the JWT expires.",
      "sourceType": "io.github.aliabbosashurov.jwt.JwtProperties",
      "defaultValue": "1h"
    },
    {
      "name": "app.security.jwt.header",
      "type": "java.lang.String",
      "description": "HTTP header name for transmitting the JWT.",
      "sourceType": "io.github.aliabbosashurov.jwt.JwtProperties",
      "defaultValue": "Authorization"
    },
    {
      "name": "app.security.jwt.issuer",
      "type": "java.lang.String",
      "description": "Issuer claim for the JWT.",
      "sourceType": "io.github.aliabbosashurov.jwt.JwtProperties",
      "defaultValue": "default-issuer"
    },
    {
      "name": "app.security.jwt.refresh-token-expiration",
      "type": "java.time.Duration",
      "description": "Duration after which the refresh token expires.",
      "sourceType": "io.github.aliabbosashurov.jwt.JwtProperties",
      "defaultValue": "7d"
    },
    {
      "name": "app.security.jwt.secret-key",
      "type": "java.lang.String",
      "description": "Secret key for signing and verifying JWTs.",
      "sourceType": "io.github.aliabbosashurov.jwt.JwtProperties"
    },
    {
      "name": "app.security.jwt.token-prefix",
      "type": "java.lang.String",
      "description": "Prefix for the JWT in the HTTP Authorization header.",
      "sourceType": "io.github.aliabbosashurov.jwt.JwtProperties",
      "defaultValue": "Bearer"
    }
  ],
  "hints": [
    {
      "name": "app.security.jwt.enabled",
      "values": [
        {
          "value": true,
          "description": "Enabled."
        },
        {
          "value": false,
          "description": "Disabled."
        }
      ]
    },
    {
      "name": "app.security.jwt.expiration",
      "values": [
        {
          "value": "30m",
          "description": "30 minutes."
        },
        {
          "value": "1h",
          "description": "1 hour."
        },
        {
          "value": "6h",
          "description": "6 hour."
        },
        {
          "value": "12h",
          "description": "12 hours."
        },
        {
          "value": "24h",
          "description": "1 day."
        }
      ]
    },
    {
      "name": "app.security.jwt.header",
      "values": [
        {
          "value": "Authorization",
          "description": "Default HTTP header for JWT."
        }
      ]
    },
    {
      "name": "app.security.jwt.refresh-token-expiration",
      "values": [
        {
          "value": "30m",
          "description": "30 minutes."
        },
        {
          "value": "1h",
          "description": "1 hour."
        },
        {
          "value": "6h",
          "description": "6 hour."
        },
        {
          "value": "12h",
          "description": "12 hours."
        },
        {
          "value": "24h",
          "description": "1 day."
        },
        {
          "value": "7d",
          "description": "7 days."
        }
      ]
    },
    {
      "name": "app.security.jwt.token-prefix",
      "values": [
        {
          "value": "Bearer",
          "description": "Standard JWT prefix."
        },
        {
          "value": "Token",
          "description": "Alternative prefix if needed."
        }
      ]
    }
  ]
}